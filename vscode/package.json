{
  "name": "parselens-vscode",
  "displayName": "ParseLens",
  "description": "Preview JSON, JSONC, JSON5, and Python repr-like diagnostics as canonical JSON.",
  "version": "0.1.0",
  "publisher": "tomorasd",
  "license": "MIT",
  "icon": "assets/icon.png",
  "keywords": [
    "json",
    "jsonc",
    "json5",
    "repr",
    "preview",
    "parser"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tablerst/ParseLens.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/tablerst/ParseLens#readme",
  "bugs": {
    "url": "https://github.com/tablerst/ParseLens/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:parselens.previewJson",
    "onCommand:parselens.previewJsonc",
    "onCommand:parselens.previewJson5",
    "onCommand:parselens.previewRepr",
    "onCommand:parselens.openDiagnosticLog"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "parselens.previewJson",
        "title": "Preview as JSON",
        "category": "ParseLens"
      },
      {
        "command": "parselens.previewJsonc",
        "title": "Preview as JSONC",
        "category": "ParseLens"
      },
      {
        "command": "parselens.previewJson5",
        "title": "Preview as JSON5",
        "category": "ParseLens"
      },
      {
        "command": "parselens.previewRepr",
        "title": "Preview as Python repr",
        "category": "ParseLens"
      },
      {
        "command": "parselens.openDiagnosticLog",
        "title": "Open Diagnostic Log",
        "category": "ParseLens"
      }
    ],
    "submenus": [
      {
        "id": "parselens.parsePreviewMenu",
        "label": "ParseLens: Parse Preview"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "parselens.parsePreviewMenu",
          "group": "navigation@90"
        }
      ],
      "parselens.parsePreviewMenu": [
        {
          "command": "parselens.previewJson",
          "group": "1_parse@10"
        },
        {
          "command": "parselens.previewJsonc",
          "group": "1_parse@20"
        },
        {
          "command": "parselens.previewJson5",
          "group": "1_parse@30"
        },
        {
          "command": "parselens.previewRepr",
          "group": "2_diag@10"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./dist/test/previewFlow.test.js",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:wasm": "node -e \"require('fs').rmSync('wasm',{recursive:true,force:true})\"",
    "build:wasm": "npm run clean:wasm && cargo build -p parselens-wasm --target wasm32-unknown-unknown --release && wasm-bindgen ../target/wasm32-unknown-unknown/release/parselens_wasm.wasm --target nodejs --out-dir ./wasm --out-name parselens_wasm",
    "build": "npm run build:wasm && npm run clean:dist && npm run compile",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --out parselens-vscode.vsix",
    "install:local": "code --install-extension parselens-vscode.vsix --force",
    "install:local:insiders": "code-insiders --install-extension parselens-vscode.vsix --force"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3"
  }
}
