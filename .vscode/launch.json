{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ParseLens VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "vscode: build extension"
    },
    {
      "name": "Run ParseLens VS Code Extension (Isolated)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
        "--disable-extensions",
        "--user-data-dir=${workspaceFolder}/.vscode-dev/user-data",
        "--extensions-dir=${workspaceFolder}/.vscode-dev/extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "vscode: build extension"
    }
  ]
}
